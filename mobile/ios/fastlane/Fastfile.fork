# Fork-specific lanes. Kept in a separate file so upstream Fastfile changes rebase cleanly.
#
# Uses Xcode automatic (cloud-managed) signing driven by an App Store Connect API key, so no
# certificate or provisioning profile has to be managed by hand, locally or on CI.
#
# Required environment:
#   APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
# Optional:
#   IMMICH_FORK_BUNDLE_ID (default net.guri-tech.immich)
#   IMMICH_FORK_TEAM_ID   (default 6955XL5BP5)

platform :ios do
  FORK_BUNDLE_ID = ENV.fetch("IMMICH_FORK_BUNDLE_ID", "net.guri-tech.immich")
  FORK_TEAM_ID = ENV.fetch("IMMICH_FORK_TEAM_ID", "6955XL5BP5")

  def fork_api_key_path
    "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8"
  end

  desc "Fork: build with automatic signing and upload to TestFlight"
  lane :fork_testflight do
    api_key = get_api_key

    increment_version_number(version_number: get_version_from_pubspec, xcodeproj: "./Runner.xcodeproj")
    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key, app_identifier: FORK_BUNDLE_ID, initial_build_number: 0) + 1,
      xcodeproj: "./Runner.xcodeproj"
    )

    gym(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Immich-fork.ipa",
      xcargs: [
        "-skipMacroValidation",
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{fork_api_key_path}",
        "-authenticationKeyID #{ENV['APP_STORE_CONNECT_API_KEY_ID']}",
        "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID']}",
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: FORK_TEAM_ID,
        uploadSymbols: true,
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: FORK_BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
